{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "rootDirs": ["src", "test"],
        "outDir": "./dist",
        "sourceMap": false,
        "declaration": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "types": ["node"]
    },
    "compileOnSave": true
}
